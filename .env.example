# Copy to .env. Never put this key into VITE_* variables or Git
KEITARO_BASE_URL=https://tlgk.host
KEITARO_API_KEY=
DATABASE_URL=postgresql+psycopg://keitaro:keitaro@127.0.0.1:5432/keitaro
# Optional; IDs are validated against Keitaro before use
DEFAULT_DOMAIN_ID=
DEFAULT_GROUP_ID=
DEFAULT_TRAFFIC_SOURCE_ID=
KEITARO_TIMEOUT=15
# Set for access through an external reverse proxy (sent as X-App-Token)
APP_ACCESS_TOKEN=

